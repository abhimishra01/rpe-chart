---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
---
<Page noindex title="Contact" description="Contact RPE Chart. Report a bug, suggest a feature or ask how the free RPE chart and calculator works. We reply to every message within a few days.">
  <p>Found a bug, a wrong number in the chart, or a feature you want? Send us a message and we will read it.</p>
  <p><a href={site.contactHref}>{site.contactLabel}</a></p>
  <p>Please include your device, your browser and the weight you entered. That helps us find the problem fast.</p>
</Page>
